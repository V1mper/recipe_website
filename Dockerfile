# Базовый образ с Python 3.13 (легковесная версия slim)
FROM python:3.13-slim

# Устанавливаем рабочую директорию внутри контейнера
WORKDIR /app

# Копируем файл с зависимостями и устанавливаем их
# (сначала только requirements.txt — так Docker кеширует слой, если зависимости не менялись)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Копируем весь остальной код проекта
COPY . .

# Открываем порт, на котором работает Flask (по умолчанию 5000)
EXPOSE 5000

# Переменная для отключения кеширования шаблонов в продакшене (опционально)
ENV FLASK_ENV=production

# Команда по умолчанию при запуске контейнера
CMD ["python", "app.py"]
